# Database (Neon / Vercel Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/dailytrader"

# App auth
APP_PASSWORD="change-me"
APP_USERNAME=""
SESSION_SECRET="generate-a-long-random-string"

# Cron protection
CRON_SECRET="generate-another-long-random-string"

# Alpaca (paper by default)
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_PAPER="true"

# Schedule (America/New_York)
SELL_AT_ET="09:29"
BUY_BEFORE_CLOSE_MINUTES="5"
TEST_BUY_NOTIONAL="10"

# Cron window tolerance (Vercel Hobby fires anytime within the UTC hour)
BUY_CRON_WINDOW_MINUTES="60"
SELL_CRON_WINDOW_MINUTES="45"

# Morning cron test (Production only). Remove after verifying.
CRON_TEST_MODE="false"
CRON_TEST_BUY_ET="10:00"
CRON_TEST_SELL_ET="11:00"

# Optional: set APP_ENV=preview locally to show the Preview label in the UI
# On Vercel, VERCEL_ENV is set automatically (preview | production | development)

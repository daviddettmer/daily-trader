generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WatchlistItem {
  id              String   @id @default(cuid())
  symbol          String   @unique
  initialNotional Decimal  @db.Decimal(12, 2)
  nextBuyNotional Decimal  @db.Decimal(12, 2)
  pendingDeposit  Decimal  @default(0) @db.Decimal(12, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EquitySnapshot {
  id          String   @id @default(cuid())
  capturedAt  DateTime @default(now())
  totalEquity Decimal  @db.Decimal(14, 2)

  @@index([capturedAt])
}

model CronRun {
  id        String   @id @default(cuid())
  route     String
  status    String
  reason    String?
  error     String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
